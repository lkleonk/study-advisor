# Copy to .env.production for local production builds, then fill in your details.
# NEXT_PUBLIC_* values are visible in the deployed website. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_COUNTRY=Deutschland
NEXT_PUBLIC_LEGAL_EMAIL=
